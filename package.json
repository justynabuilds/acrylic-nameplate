{
  "name": "@justbuilt/acrylic-nameplate",
  "version": "0.1.0",
  "description": "Acrylic Nameplate: your name engraved in an edge-lit acrylic plate on a machined base, with a rocker switch that turns the light on and off. A web component and a React component on one framework-free core.",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Justyna Dabrowska",
  "homepage": "https://acrylic-nameplate.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justynabuilds/acrylic-nameplate.git"
  },
  "bugs": {
    "url": "https://github.com/justynabuilds/acrylic-nameplate/issues"
  },
  "keywords": [
    "web-component",
    "custom-element",
    "react",
    "nameplate",
    "about",
    "portfolio",
    "ui-component",
    "typescript"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "type": "module",
  "main": "./dist/acrylic-nameplate.js",
  "module": "./dist/acrylic-nameplate.js",
  "types": "./dist/types/element/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/element/index.d.ts",
      "import": "./dist/acrylic-nameplate.js",
      "default": "./dist/acrylic-nameplate.iife.js"
    },
    "./react": "./src/react/AcrylicNameplate.tsx",
    "./core": "./src/core/engine.ts"
  },
  "files": [
    "dist",
    "src",
    "fonts",
    "README.md"
  ],
  "scripts": {
    "dev": "vite --config vite.site.config.ts",
    "build": "vite build && tsc -p tsconfig.types.json",
    "build:site": "vite build && vite build --config vite.site.config.ts && cp dist/acrylic-nameplate.iife.js dist/acrylic-nameplate.js site-dist/",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/*.test.ts\"",
    "preview": "vite preview --config vite.site.config.ts"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
